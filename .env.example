# Copier en .env puis adapter : docker compose lit ce fichier automatiquement.
# Le .env n'est pas versionne (cf .gitignore).

POSTGRES_DB=ferme
POSTGRES_USER=ferme
# Generer une valeur locale, par exemple : openssl rand -hex 24
POSTGRES_PASSWORD=change-moi

# Utilise par l'API (docker compose les passe deja au service api)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ferme
SPRING_DATASOURCE_USERNAME=ferme
SPRING_DATASOURCE_PASSWORD=change-moi

# Jeu de donnees de demonstration au demarrage
FERME_DONNEES_DEMO=true

# Ports exposes sur la machine hote
API_PORT=8080
WEB_PORT=3000
